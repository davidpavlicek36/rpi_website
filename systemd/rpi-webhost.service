[Unit]
Description=RPi Website Management GUI
Documentation=https://github.com/YOUR_USERNAME/rpi_website
After=network.target nginx.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rpi-webhost/gui
ExecStart=/usr/bin/python3 /opt/rpi-webhost/gui/app.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# Security hardening — keep the GUI locked to loopback
# (SSH tunnel is the only access path)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
