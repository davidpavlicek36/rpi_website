#!/usr/bin/env python3
"""Privileged helper for rpi-webhost: change the tunnel token or domain after install.

Installed to /usr/local/sbin (root:root 755) and called by the GUI through a
narrow sudoers entry, or directly:

    sudo rpi-webhost-config set-token            # tunnel token on stdin
    sudo rpi-webhost-config set-domain DOMAIN    # Cloudflare API token on stdin
    sudo rpi-webhost-config save-domain DOMAIN   # just record DOMAIN in config.env
    sudo rpi-webhost-config harden-token         # move a legacy --token out of the process args
    sudo rpi-webhost-config status

Secrets are only ever read from stdin, never from argv (argv shows up in `ps`).
The tunnel token is stored in a root-only EnvironmentFile (TUNNEL_TOKEN=…), not on the
cloudflared command line, so other local users cannot read it from `ps` or the unit file.
The Cloudflare API token is used once and never written to disk.
Messages on stdout/stderr are safe to show to a user: secrets are scrubbed.
Every change is written to syslog (facility auth) without secrets.
This runs as root inside a directory the GUI user owns, so it never follows symlinks there.
"""
import base64
import binascii
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import syslog
import time
import urllib.error
import urllib.request
from pathlib import Path

# Overridable for tests only. `sudo` resets the environment, so the GUI cannot set these.
CF_API = os.environ.get('CF_API_BASE', 'https://api.cloudflare.com/client/v4')
INSTALL_DIR = Path(os.environ.get('RPI_WEBHOST_DIR', '/opt/rpi-webhost'))
UNIT_FILE = Path(os.environ.get('RPI_WEBHOST_UNIT', '/etc/systemd/system/cloudflared.service'))
TOKEN_FILE = Path(os.environ.get('RPI_WEBHOST_TOKEN_FILE', '/etc/cloudflared/tunnel.env'))
CONFIG_FILE = INSTALL_DIR / 'config.env'
SERVICE_USER = 'rpi-webhost'
CONNECT_TIMEOUT = int(os.environ.get('RPI_WEBHOST_CONNECT_TIMEOUT', '40'))

DOMAIN_RE = re.compile(r'[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z]{2,})+')
ID_RE = re.compile(r'[A-Za-z0-9-]{8,64}')


class Fail(Exception):
    """A user-facing error; the message must not contain secrets."""


def scrub(text, *secrets):
    for s in secrets:
        if s:
            text = text.replace(s, '***')
    return text


def run(cmd, timeout=60):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


# ── Tunnel token ──────────────────────────────────────────────────────────────

def parse_token(raw):
    """Return (token, {'a','t','s'}). Accepts a bare token or a pasted
    `cloudflared service install <token>` command (the last word is used)."""
    words = raw.split()
    if not words:
        raise Fail('No tunnel token provided.')
    token = words[-1]
    try:
        # -len % 4 pads correctly; `4 - len % 4` adds 4 '=' when already aligned.
        data = json.loads(base64.b64decode(token + '=' * (-len(token) % 4), validate=True))
    except (binascii.Error, ValueError):
        raise Fail('That does not look like a Cloudflare tunnel token.')
    # 'a' and 't' end up in API URLs, so they are strictly validated. 's' is base64 and only passed through.
    if not isinstance(data, dict) or not all(
            isinstance(data.get(k), str) and ID_RE.fullmatch(data[k]) for k in ('a', 't')) \
            or not isinstance(data.get('s'), str) or not data['s']:
        raise Fail('Token is missing the account, tunnel or secret fields. '
                   'Copy it again from Zero Trust > Networks > Tunnels.')
    return token, data


def write_root_file(path, text, mode):
    """Atomically write a root-owned file with the given mode (parent dirs are root-owned)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + '.tmp')
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, 'w') as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise
    os.replace(str(tmp), str(path))


def read_text_or_none(path):
    try:
        return path.read_text()
    except FileNotFoundError:
        return None


def unit_text():
    return (
        '[Unit]\nDescription=cloudflared\nAfter=network-online.target\nWants=network-online.target\n\n'
        '[Service]\nTimeoutStartSec=0\nType=notify\n'
        'EnvironmentFile=%s\n'
        'ExecStart=%s --no-autoupdate tunnel run\n'
        'Restart=on-failure\nRestartSec=5s\n\n'
        '[Install]\nWantedBy=multi-user.target\n'
    ) % (TOKEN_FILE, shutil.which('cloudflared') or '/usr/local/bin/cloudflared')


def current_token():
    env = read_text_or_none(TOKEN_FILE)
    m = re.search(r'^TUNNEL_TOKEN=(\S+)', env or '', re.M)
    if not m:  # legacy install: token on the ExecStart line
        unit = read_text_or_none(UNIT_FILE)
        m = re.search(r'--token\s+([A-Za-z0-9+/=_-]+)', unit or '')
    if not m:
        raise Fail('cloudflared is not installed as a service yet. Set the tunnel token first.')
    return parse_token(m.group(1))[1]


def wait_for_connection(since):
    deadline = time.time() + CONNECT_TIMEOUT
    while True:
        try:
            r = run(['journalctl', '-u', 'cloudflared', '--since', since, '--no-pager', '-q'], timeout=10)
            if 'Registered tunnel connection' in r.stdout:
                return True
        except (subprocess.SubprocessError, OSError):
            pass
        if time.time() >= deadline:
            return False
        time.sleep(2)


def audit(message):
    """Syslog line for every change. Callers must never pass secrets."""
    who = os.environ.get('SUDO_USER') or 'root'
    syslog.openlog('rpi-webhost-config', 0, syslog.LOG_AUTH)
    syslog.syslog(syslog.LOG_NOTICE, '%s (invoked by %s)' % (message, who))
    syslog.closelog()


def apply_token(token, tunnel_id):
    """Install token + unit, restart, and roll back if the tunnel does not connect."""
    if not shutil.which('cloudflared'):
        raise Fail('cloudflared is not installed.')
    old_env, old_unit = read_text_or_none(TOKEN_FILE), read_text_or_none(UNIT_FILE)

    def rollback():
        if old_env is None and old_unit is None:
            return 'No previous tunnel configuration existed to restore.'
        if old_env is not None:
            write_root_file(TOKEN_FILE, old_env, 0o600)
        if old_unit is not None:
            write_root_file(UNIT_FILE, old_unit, 0o644)
        run(['systemctl', 'daemon-reload'])
        run(['systemctl', 'restart', 'cloudflared'])
        return 'The previous tunnel configuration was restored.'

    write_root_file(TOKEN_FILE, 'TUNNEL_TOKEN=%s\n' % token, 0o600)
    write_root_file(UNIT_FILE, unit_text(), 0o644)
    run(['systemctl', 'daemon-reload'])
    run(['systemctl', 'enable', 'cloudflared'])
    since = time.strftime('%Y-%m-%d %H:%M:%S')
    run(['systemctl', 'restart', 'cloudflared'])
    if not wait_for_connection(since):
        audit('tunnel token change FAILED (tunnel %s did not connect)' % tunnel_id)
        raise Fail('The new token did not connect to Cloudflare within %d s. %s' % (CONNECT_TIMEOUT, rollback()))
    audit('tunnel token changed (tunnel %s)' % tunnel_id)


def cmd_set_token():
    token, data = parse_token(sys.stdin.read(16384))
    apply_token(token, data['t'])
    print('Tunnel token replaced and the tunnel is connected.')


def cmd_harden_token():
    """Move a token that is still on the cloudflared command line into the root-only env file."""
    unit = read_text_or_none(UNIT_FILE) or ''
    m = re.search(r'--token\s+([A-Za-z0-9+/=_-]+)', unit)
    if not m:
        print('Tunnel token is already stored outside the process arguments.')
        return
    token, data = parse_token(m.group(1))
    apply_token(token, data['t'])
    print('Tunnel token moved out of the process arguments.')


# ── Cloudflare API ────────────────────────────────────────────────────────────

def cf(method, path, api_token, body=None):
    what = '%s %s' % (method, path.split('?')[0])
    req = urllib.request.Request(
        CF_API + path, method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'Authorization': 'Bearer ' + api_token,
                 'Content-Type': 'application/json',
                 'User-Agent': 'rpi-webhost-config'})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            payload = json.load(resp)
    except urllib.error.HTTPError as e:
        try:
            payload = json.load(e)
        except ValueError:
            raise Fail('Cloudflare API returned HTTP %d for %s.' % (e.code, what))
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise Fail('Could not reach the Cloudflare API: %s' % scrub(str(getattr(e, 'reason', e)), api_token))
    if not isinstance(payload, dict) or not payload.get('success'):
        errs = '; '.join(str(x.get('message', 'error')) for x in (payload.get('errors') or [])
                         if isinstance(x, dict)) if isinstance(payload, dict) else ''
        raise Fail('Cloudflare API error on %s: %s' % (what, scrub(errs or 'unknown error', api_token)))
    return payload


def upsert_cname(zone_id, name, target, api_token):
    found = cf('GET', '/zones/%s/dns_records?type=CNAME&name=%s' % (zone_id, name), api_token)
    record = {'type': 'CNAME', 'name': name, 'content': target, 'proxied': True}
    existing = found.get('result') or []
    if existing:
        cf('PATCH', '/zones/%s/dns_records/%s' % (zone_id, existing[0]['id']), api_token, record)
    else:
        cf('POST', '/zones/%s/dns_records' % zone_id, api_token, record)


def build_ingress(current, hostname):
    """Keep every other hostname the user configured; set ours; catch-all last."""
    others = [r for r in (current or []) if r.get('hostname') and r['hostname'] != hostname]
    return others + [{'hostname': hostname, 'service': 'http://localhost:80'},
                     {'service': 'http_status:404'}]


def check_domain(domain):
    if not DOMAIN_RE.fullmatch(domain):
        raise Fail('Invalid domain name.')
    return domain.lower()


def read_config():
    """Read config.env without following symlinks (the directory belongs to the GUI user)."""
    try:
        fd = os.open(str(CONFIG_FILE), os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return ''
    except OSError:
        raise Fail('config.env is not a regular file; refusing to touch it.')
    with os.fdopen(fd) as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise Fail('config.env is not a regular file; refusing to touch it.')
        return f.read()


def write_config(text):
    """Write config.env as root without following symlinks or hardlinks."""
    existed = os.path.lexists(CONFIG_FILE)
    try:
        fd = os.open(str(CONFIG_FILE), os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        raise Fail('config.env is not a regular file; refusing to touch it.')
    with os.fdopen(fd, 'w') as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise Fail('config.env is not a plain file; refusing to touch it.')
        f.truncate(0)
        f.write(text)
        if not existed:
            try:
                u = pwd.getpwnam(SERVICE_USER)
                os.fchown(f.fileno(), u.pw_uid, u.pw_gid)
            except (KeyError, OSError):
                pass


def save_domain(domain):
    lines = [x for x in read_config().splitlines() if not x.startswith('DOMAIN=')]
    lines.append('DOMAIN=' + domain)
    write_config('\n'.join(lines) + '\n')


def cmd_set_domain(domain):
    domain = check_domain(domain)
    api_token = sys.stdin.readline().strip()
    if not api_token:
        raise Fail('No Cloudflare API token provided.')
    tunnel = current_token()
    hostname = 'www.' + domain

    zones = cf('GET', '/zones?name=' + domain, api_token).get('result') or []
    if not zones:
        raise Fail("Zone not found for '%s'. Add the domain to Cloudflare and check the API token "
                   "has Zone:Read and DNS:Edit." % domain)
    upsert_cname(zones[0]['id'], hostname, tunnel['t'] + '.cfargotunnel.com', api_token)

    path = '/accounts/%s/cfd_tunnel/%s/configurations' % (tunnel['a'], tunnel['t'])
    current = (cf('GET', path, api_token).get('result') or {}).get('config') or {}
    current['ingress'] = build_ingress(current.get('ingress'), hostname)
    cf('PUT', path, api_token, {'config': current})

    save_domain(domain)
    audit('DNS and tunnel route set for %s (tunnel %s)' % (hostname, tunnel['t']))
    print('%s now points at this Pi through the tunnel.' % hostname)


# ── Status ────────────────────────────────────────────────────────────────────

def cmd_status():
    try:
        tunnel_id = current_token()['t']
    except Fail:
        tunnel_id = ''
    domain = ''
    try:
        for line in read_config().splitlines():
            if line.startswith('DOMAIN='):
                domain = line.partition('=')[2].strip()
    except Fail:
        domain = '(unreadable)'
    try:
        active = run(['systemctl', 'is-active', 'cloudflared'], timeout=5).stdout.strip() or 'unknown'
    except (subprocess.SubprocessError, OSError):
        active = 'unknown'
    print('tunnel_service=%s\ntunnel_id=%s\ndomain=%s' % (active, tunnel_id, domain))


# ── Entry point ───────────────────────────────────────────────────────────────

def main(argv):
    if os.geteuid() != 0 and not os.environ.get('RPI_WEBHOST_TEST'):
        raise Fail('Run as root: sudo rpi-webhost-config <command>')
    cmd, args = (argv[1] if len(argv) > 1 else ''), argv[2:]
    if cmd == 'set-token' and not args:
        cmd_set_token()
    elif cmd == 'set-domain' and len(args) == 1:
        cmd_set_domain(args[0])
    elif cmd == 'save-domain' and len(args) == 1:
        save_domain(check_domain(args[0]))
        print('Domain saved.')
    elif cmd == 'harden-token' and not args:
        cmd_harden_token()
    elif cmd == 'status' and not args:
        cmd_status()
    else:
        raise Fail('Usage: rpi-webhost-config set-token | set-domain DOMAIN | save-domain DOMAIN | harden-token | status')


if __name__ == '__main__':
    try:
        main(sys.argv)
    except Fail as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print('A system command timed out.', file=sys.stderr)
        sys.exit(1)
